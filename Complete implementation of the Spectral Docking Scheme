import numpy as np
from scipy.linalg import eigh
import matplotlib.pyplot as plt

class SpectralDocking:
    """
    A class implementing the spectral geometry approach to protein docking
    based on Apollonian sphere packing and curvature matrix analysis.
    """
    
    def __init__(self, epsilon=0.5):
        """
        Initialize the SpectralDocking class.
        
        Args:
            epsilon (float): Contact threshold parameter in Angstroms
        """
        self.epsilon = epsilon
        self.atomic_radii = {
            'C': 1.70, 'N': 1.55, 'O': 1.52, 'H': 1.20,
            'S': 1.80, 'P': 1.80, 'F': 1.47, 'Cl': 1.75
        }
    
    def calculate_pairwise_distances(self, coordinates):
        """
        Calculate pairwise Euclidean distances between all points.
        
        Args:
            coordinates (np.array): Nx3 array of atomic coordinates
            
        Returns:
            list: Flat list of pairwise distances
        """
        n = len(coordinates)
        distances = []
        for i in range(n):
            for j in range(i + 1, n):
                dist = np.linalg.norm(coordinates[i] - coordinates[j])
                distances.append(dist)
        return distances
    
    def construct_curvature_matrix(self, radii, distances):
        """
        Construct the generalized curvature matrix M_g.
        
        Args:
            radii (list): List of atomic radii
            distances (list): List of pairwise distances
            
        Returns:
            tuple: (M_g matrix, lambda_min)
        """
        n = len(radii)
        M_g = np.eye(n)  # Initialize with identity matrix
        
        k = 0
        for i in range(n):
            for j in range(i + 1, n):
                d = distances[k]
                # Check if atoms are in contact
                if d <= radii[i] + radii[j] + self.epsilon:
                    # Calculate contact weight
                    w_ij = (radii[i]**2 + radii[j]**2 - d**2) / (2 * radii[i] * radii[j])
                    M_g[i, j] = -w_ij
                    M_g[j, i] = -w_ij
                k += 1
        
        # Calculate eigenvalues
        eigenvalues, _ = eigh(M_g)
        lambda_min = np.min(eigenvalues)
        
        return M_g, lambda_min
    
    def validate_stability_metric(self):
        """
        Validate the spectral stability metric with test configurations.
        """
        print("VALIDATING SPECTRAL STABILITY METRIC")
        print("=" * 50)
        
        # Test configurations
        radii = [1.5, 1.6, 1.4, 1.8]
        
        # Well-packed configuration
        distances_well = [3.1, 3.0, 3.2, 3.0, 3.1, 3.3]
        M_g_well, lambda_well = self.construct_curvature_matrix(radii, distances_well)
        
        # Poorly-packed configuration  
        distances_poor = [4.0, 4.2, 4.5, 4.1, 4.3, 4.4]
        M_g_poor, lambda_poor = self.construct_curvature_matrix(radii, distances_poor)
        
        # Calculate percentage difference
        percent_diff = ((lambda_well - lambda_poor) / lambda_poor) * 100
        
        print(f"Well-packed configuration:")
        print(f"  Distances: {distances_well}")
        print(f"  λ_min(M_g): {lambda_well:.4f}")
        print(f"  Matrix condition number: {np.linalg.cond(M_g_well):.2f}")
        
        print(f"\nPoorly-packed configuration:")
        print(f"  Distances: {distances_poor}") 
        print(f"  λ_min(M_g): {lambda_poor:.4f}")
        print(f"  Matrix condition number: {np.linalg.cond(M_g_poor):.2f}")
        
        print(f"\nResults:")
        print(f"  Stability difference: {percent_diff:.1f}%")
        print(f"  Hypothesis supported: {lambda_well > lambda_poor}")
        
        return {
            'well_packed': {'lambda': lambda_well, 'matrix': M_g_well},
            'poorly_packed': {'lambda': lambda_poor, 'matrix': M_g_poor},
            'percent_difference': percent_diff
        }
    
    def analyze_ideal_packing(self):
        """
        Analyze the ideal Apollonian packing case.
        """
        print("\nANALYZING IDEAL APOLLONIAN PACKING")
        print("=" * 50)
        
        # Ideal curvature matrix for 4 mutually tangent spheres
        M_ideal = np.array([
            [1, -0.5, -0.5, -0.5],
            [-0.5, 1, -0.5, -0.5], 
            [-0.5, -0.5, 1, -0.5],
            [-0.5, -0.5, -0.5, 1]
        ])
        
        # Calculate eigenvalues
        eigenvalues, eigenvectors = eigh(M_ideal)
        
        print("Ideal Curvature Matrix M:")
        print(M_ideal)
        print(f"\nEigenvalues: {eigenvalues}")
        print(f"Multiplicities: 0 (1), 1.5 (3)")
        print(f"Positive semi-definite: {np.all(eigenvalues >= 0)}")
        
        # Verify Descartes relation in null space
        k_vector = np.array([1, 1, 1, 1])  # Example curvature vector
        descartes_validation = k_vector @ M_ideal @ k_vector
        print(f"Descartes relation validation: {descartes_validation:.2f} (should be 0)")
        
        return M_ideal, eigenvalues

def demonstration():
    """
    Complete demonstration of the spectral docking framework.
    """
    print("SPECTRAL DOCKING FRAMEWORK DEMONSTRATION")
    print("=" * 50)
    
    # Initialize the docking analyzer
    docking_analyzer = SpectralDocking(epsilon=0.5)
    
    # 1. Analyze ideal packing
    M_ideal, eigenvalues = docking_analyzer.analyze_ideal_packing()
    
    # 2. Validate stability metric
    results = docking_analyzer.validate_stability_metric()
    
    # 3. Additional test case
    print("\nADDITIONAL TEST CASE")
    print("=" * 50)
    
    test_radii = [1.6, 1.6, 1.6, 1.6]  # Equal radii
    test_distances = [3.2, 3.2, 3.2, 3.2, 3.2, 3.2]  # Equal distances
    
    M_test, lambda_test = docking_analyzer.construct_curvature_matrix(test_radii, test_distances)
    print(f"Test configuration (equal spheres):")
    print(f"  Radii: {test_radii}")
    print(f"  Distances: {test_distances}")
    print(f"  λ_min(M_g): {lambda_test:.4f}")
    
    return results

if __name__ == "__main__":
